generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  DELIVERY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum LoyaltyTier {
  NEW
  REGULAR
  VIP
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum PaymentMethod {
  TELEBIRR
  CBE_BIRR
  CHAPA
  COD
}

enum PaymentStatus {
  PAID
  PENDING
  PENDING_COD
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_DELIVERY
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum StockMovementType {
  RESTOCK
  SALE
  DAMAGED
  EXPIRED
}

model User {
  id              String          @id @default(cuid())
  fullName        String
  email           String          @unique
  phone           String?
  passwordHash    String
  role            Role            @default(CUSTOMER)
  avatar          String?
  status          UserStatus      @default(ACTIVE)
  loyaltyTier     LoyaltyTier     @default(NEW)
  isOnline        Boolean         @default(false)
  vehicleType     String?
  plateNumber     String?
  assignedZone    String?
  rating          Float           @default(0)
  codCashHeld     Decimal         @default(0) @db.Decimal(12, 2)
  resetOtp        String?
  resetOtpExpires DateTime?
  createdAt       DateTime        @default(now())
  addresses       Address[]
  wishlistItems   WishlistItem[]
  customerOrders  Order[]         @relation("CustomerOrders")
  deliveryOrders  Order[]         @relation("DeliveryOrders")
  transactions    Transaction[]
  reviews         Review[]
  supportTickets  SupportTicket[]
  stockMovements  StockMovement[] @relation("StockMovementCreator")
  auditLogs       AuditLog[]

  @@index([role, status])
  @@index([assignedZone])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String
  zone      String
  street    String
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishlistItem {
  id        String  @id @default(cuid())
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  image        String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  isFeatured   Boolean   @default(false)
  products     Product[]

  @@index([isActive, displayOrder])
}

model Product {
  id                String          @id @default(cuid())
  name              String
  sku               String          @unique
  categoryId        String
  description       String?
  price             Decimal         @db.Decimal(12, 2)
  compareAtPrice    Decimal?        @db.Decimal(12, 2)
  unit              String
  stock             Int             @default(0)
  lowStockThreshold Int             @default(5)
  expiryDate        DateTime?
  supplier          String?
  image             String?
  isFeatured        Boolean         @default(false)
  isActive          Boolean         @default(true)
  rating            Float           @default(0)
  category          Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  wishlistItems     WishlistItem[]
  stockMovements    StockMovement[]
  orderItems        OrderItem[]
  reviews           Review[]

  @@index([categoryId, isActive])
  @@index([isFeatured, isActive])
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  type      StockMovementType
  quantity  Int
  note      String?
  createdBy String?
  createdAt DateTime          @default(now())
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator   User?             @relation("StockMovementCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([createdBy])
}

model Order {
  id             String        @id @default(cuid())
  orderCode      String        @unique
  customerId     String
  riderId        String?
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  deliveryFee    Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  couponCode     String?
  deliveryZone   String
  deliveryStreet String
  customerPhone  String
  timeSlot       String
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  orderStatus    OrderStatus   @default(PLACED)
  deliveryOtp    String
  deliveryNote   String?
  issueReport    String?
  createdAt      DateTime      @default(now())
  customer       User          @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  rider          User?         @relation("DeliveryOrders", fields: [riderId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  transactions   Transaction[]

  @@index([customerId, createdAt])
  @@index([riderId, orderStatus])
  @@index([orderStatus, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  unit      String
  image     String?
  price     Decimal @db.Decimal(12, 2)
  qty       Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Transaction {
  id        String        @id @default(cuid())
  txnCode   String        @unique
  orderId   String
  userId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  status    PaymentStatus
  txRef     String?
  createdAt DateTime      @default(now())
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([userId, createdAt])
}

model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  description  String?
  discountType DiscountType
  value        Decimal      @db.Decimal(12, 2)
  minOrder     Decimal      @default(0) @db.Decimal(12, 2)
  usageLimit   Int?
  usedCount    Int          @default(0)
  expiryDate   DateTime?
  isActive     Boolean      @default(true)

  @@index([isActive, expiryDate])
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  userId     String
  orderCode  String
  rating     Int
  comment    String
  adminReply String?
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId, orderCode])
  @@index([productId, status])
  @@index([userId, createdAt])
}

model SupportTicket {
  id         String       @id @default(cuid())
  ticketCode String       @unique
  userId     String?
  name       String
  email      String
  phone      String
  orderCode  String?
  topic      String
  messages   Json
  status     TicketStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Notification {
  id         String   @id @default(cuid())
  title      String
  message    String
  category   String
  priority   String   @default("NORMAL")
  actionPath String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([isRead, createdAt])
}

model StoreSetting {
  id                    String  @id @default(cuid())
  storeName             String
  tagline               String
  supportEmail          String
  supportPhone          String
  warehouseAddress      String
  logoUrl               String?
  isStoreOpen           Boolean @default(true)
  maintenanceMessage    String  @default("")
  freeDeliveryThreshold Decimal @db.Decimal(12, 2)
  standardFee           Decimal @db.Decimal(12, 2)
  expressFee            Decimal @db.Decimal(12, 2)
  minOrderAmount        Decimal @db.Decimal(12, 2)
  vatRate               Decimal @db.Decimal(5, 4)
  requireDeliveryOtp    Boolean @default(true)
  zones                 Json
  paymentGateways       Json
  timeSlots             Json
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  actorRole String
  action    String
  entity    String
  entityId  String?
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
}
