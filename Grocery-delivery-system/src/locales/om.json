    "Rider Assigned": "Geessaan ramadame",
    "Notify admins when a customer submits an order": {
      "": "Maamilaan ajaja yeroo galchu bulchitoota beeksisi."
    },
    "Alert the team when products reach their reorder threshold": {
      "": "Oomishni daangaa irra deebi’anii ajajuu yeroo ga’an garee akeekkachiisi."
    },
    "Notify the team about products approaching expiry": {
      "": "Yeroon oomishaa dhumuu yeroo dhihaatu garee beeksisi."
