    "Manage local delivery fees and temporarily pause service in a zone": {
      "": "Kaffaltii geejjibaa naannoo bulchiitii tajaajila naannoo tokko yeroo muraasaaf dhaabi."
    },
    "Customers can choose from active delivery windows at checkout": {
      "": "Maamiltoonni yeroo geejjibaa socho’aa checkout irratti filachuu danda’u."
    },
    "Enable the payment options customers can use to complete grocery orders": {
      "": "Filannoowwan kaffaltii ajaja suuqii xumuruuf maamiltoonni fayyadaman hojii irra oolchi."
    },
    "Control how value-added tax is presented and calculated at checkout": {
      "": "Akkaataa gibirri dabalata gatii checkout irratti itti mul’atuu fi shallagamu to’adhu."
    },
    "Do not add VAT again at checkout when enabled": {
      "": "Yoo hojii irra oole, checkout irratti VAT irra deebi’ii hin dabaliin."
    },
    "Choose when the team receives stock alerts and how long orders remain unpaid": {
      "": "Yoom gareen akeekkachiisa kuusaa argatuu fi ajajawwan kaffaltii hin arganne hammam turan filadhu."
    },
    "Optional protections and automation for warehouse and delivery teams": {
      "": "Eegumsa filannoo fi ofumaan hojjechuu gareewwan kuusaa fi geejjibaaf."
    },
    "Ask the customer for a one-time code before completing a delivery": {
      "": "Geejjiba xumuruu dura maamilaa koodii yeroo tokkoo gaafadhu."
    },
    "Allow customers to place orders for temporarily unavailable products": {
      "": "Maamiltoonni oomisha yeroo muraasaaf hin jirre ajaju akka danda’an hayyami."
    },
    "Assign new deliveries to the closest available rider automatically": {
      "": "Geejjiba haaraa ofumaan geessaa jiru dhihoo jiruuf ramadi."
    },
    "Choose which operational events should notify the store team": {
      "": "Taateewwan hojii keessaa kamtu garee suuqii beeksisuu akka qabu filadhu."
    },
    "Send customers clear updates during order fulfillment": {
      "": "Yeroo ajajni raawwatamu haaromsa ifa ta’e maamiltootaaf ergi."
    },
    "Use a strong, unique password": {
      " Password updates require a secure server-side account service": {
        "": "Jecha darbii cimaa fi addaa fayyadami. Jecha darbii haaromsuuf tajaajilli herregaa sarverii nageenya qabu barbaachisa."
      }
    },
    "Add an extra verification step to protect administrator access": {
      "": "Seensa bulchaa eeguuf tarkaanfii mirkaneessaa dabalataa dabali."
    },
    "Require an additional verification code when signing in": {
      "": "Yeroo seentu koodii mirkaneessaa dabalataa gaafadhu."
    },
    "Review where your administrator account is currently signed in": {
      "": "Herregni bulchaa kee amma eessatti akka seene ilaali."
    },
    "New Order Alert": "Beeksisa ajaja haaraa",
    "Low Stock Warning": "Akeekkachiisa kuusaa xiqqaa",
    "Product Expiring Soon": "Oomishni yeroo dhihootti dhumata",
